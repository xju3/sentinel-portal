/* components/stat-card/stat-card.wxss */
.stat-card {
  background: var(--color-bg-card);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 16rpx 20rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx var(--color-shadow);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
}

.stat-card__label-container {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  gap: 4rpx;
}

.stat-card__icon {
  width: 28rpx;
  height: 28rpx;
  mask-size: 100% 100%;
  -webkit-mask-size: 100% 100%;
  mask-repeat: no-repeat;
  -webkit-mask-repeat: no-repeat;
}

