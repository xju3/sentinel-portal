.stat-card__label {
  font-size: 24rpx;
  font-weight: 600;
  transform: translateY(2rpx);
}

.stat-card__data {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  flex-shrink: 1;
  min-width: 0;
  justify-content: flex-end;
}

.stat-card__value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  line-height: 1;
  text-shadow: 0 0 12rpx rgba(255, 255, 255, 0.3);
}

.stat-card__unit {
  font-size: 20rpx;
  color: var(--color-text-secondary);
}
