<view class="health-device-card" bindtap="onTap">
  <view class="health-device-card__header">
    <view class="health-device-card__title-wrap">
      <text class="health-device-card__name">{{item.name}}</text>
      <text class="health-device-card__code">{{item.code}}</text>
    </view>
    <view class="health-device-card__favorite {{item.isFavorite ? 'health-device-card__favorite--active' : ''}}" catchtap="onFavoriteTap">
      <text>{{item.isFavorite ? '★ 已关注' : '☆ 关注'}}</text>
    </view>
  </view>

  <view class="health-device-card__tags">
    <view class="health-device-card__tag" wx:if="{{item.specName}}">
      <text class="health-device-card__tag-label">规格</text>
      <text class="health-device-card__tag-value">{{item.specName}}</text>
    </view>
    <view class="health-device-card__tag" wx:if="{{item.categoryName}}">
      <text class="health-device-card__tag-label">分类</text>
      <text class="health-device-card__tag-value">{{item.categoryName}}</text>
    </view>
  </view>
</view>
