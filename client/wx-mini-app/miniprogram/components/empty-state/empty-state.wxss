.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  width: 100%;
  box-sizing: border-box;
}

.empty-state__icon-wrapper {
  margin-bottom: 32rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-state__icon-img {
  width: 160rpx;
  height: 160rpx;
  opacity: 0.6;
}

/* Default CSS Icon */
.empty-state__icon-default {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-circle {
  position: absolute;
  border-radius: 50%;
  border: 2rpx dashed rgba(26, 110, 245, 0.3);
}

.icon-circle--outer {
  width: 140rpx;
  height: 140rpx;
  border-style: solid;
  border-color: rgba(26, 110, 245, 0.1);
  background: radial-gradient(circle, rgba(26, 110, 245, 0.05) 0%, transparent 70%);
}

.icon-circle--inner {
  width: 90rpx;
  height: 90rpx;
  animation: spin 10s linear infinite;
}

.icon-shape {
  width: 40rpx;
  height: 40rpx;
  background: #1A6EF5;
  opacity: 0.5;
  border-radius: 6rpx;
  transform: rotate(45deg);
  box-shadow: 0 0 20rpx rgba(26, 110, 245, 0.4);
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.empty-state__title {
  font-size: 30rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.6);
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}

.empty-state__desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.3);
  text-align: center;
  max-width: 80%;
  line-height: 1.5;
}
