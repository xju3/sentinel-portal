<view class="spec-card" bindtap="onTap">
  <view class="spec-card__header">
    <view class="spec-card__color" style="background-color: {{item.device_category.color || '#8c96a9'}}"></view>
    <text class="spec-card__title">{{item.name}}</text>
    <text class="spec-card__brand" wx:if="{{item.brand}}">{{item.brand}}</text>
    <text class="spec-card__chevron">›</text>
  </view>

  <view class="spec-card__body">
    <text class="spec-card__model">{{item.model || '型号未设置'}}</text>
    <view class="spec-card__detail-row">
      <text class="spec-card__category">{{item.device_category.name || '未分类'}}</text>
      <text class="spec-card__parameters" wx:if="{{item.rpm || item.voltage}}">{{item.rpm ? item.rpm + ' RPM' : ''}}{{item.rpm && item.voltage ? ' · ' : ''}}{{item.voltage ? item.voltage + ' V' : ''}}</text>
    </view>
  </view>
</view>
