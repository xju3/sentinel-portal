.spec-card {
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  transition: all 0.3s ease;
  box-sizing: border-box;
}

.spec-card:active {
  background: rgba(255, 255, 255, 0.06);
}

.spec-card__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
  padding-bottom: 16rpx;
}

.spec-card__title {
  font-size: 32rpx;
  color: #fff;
  font-weight: 600;
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-right: 16rpx;
}

.spec-card__brand {
  font-size: 22rpx;
  color: #00D2FF;
  background: rgba(0, 210, 255, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}

.spec-card__body {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx 24rpx;
}

.spec-info {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.spec-info__label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.45);
  flex-shrink: 0;
}

.spec-category-tag {
  display: inline-flex;
  align-items: center;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  max-width: 100%;
}

.spec-info__value {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex: 1;
}
