.spec-card {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding: 22rpx 24rpx;
  border: 1rpx solid rgba(0, 210, 255, 0.12);
  border-radius: 20rpx;
  background: linear-gradient(180deg, rgba(16, 27, 44, 0.88) 0%, rgba(10, 16, 28, 0.94) 100%);
  box-shadow: 0 6rpx 22rpx rgba(0, 210, 255, 0.05);
  transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
}

.spec-card:active {
  background: rgba(255, 255, 255, 0.06);
  border-color: rgba(0, 210, 255, 0.24);
  transform: scale(0.994);
}

.spec-card__header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 10rpx;
}

.spec-card__color {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.spec-card__title {
  min-width: 0;
  overflow: hidden;
  color: #fff;
  font-size: 29rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
}

.spec-card__brand {
  flex-shrink: 0;
  max-width: 160rpx;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.45);
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.spec-card__chevron {
  flex-shrink: 0;
  color: rgba(255, 255, 255, 0.24);
  font-size: 34rpx;
  line-height: 1;
}

.spec-card__body {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding-left: 24rpx;
}

.spec-card__detail-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.spec-card__model,
.spec-card__category,
.spec-card__parameters {
  min-width: 0;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.45);
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.spec-card__category {
  flex: 1;
}

.spec-card__parameters {
  flex-shrink: 0;
}
