/**pages/home/home.wxss**/
page {
  height: 100vh;
  background: var(--color-bg);
}

.page {
  height: 100vh;
}

/* ── Section ─────────────────────────────────────────────── */
.section {
  padding: 48rpx 32rpx 0;
}

.section__header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 24rpx;
}

.section__title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section__title-icon {
  width: 36rpx;
  height: 36rpx;
  background-color: var(--color-primary);
  mask-size: 100% 100%;
  -webkit-mask-size: 100% 100%;
  mask-repeat: no-repeat;
  -webkit-mask-repeat: no-repeat;
}

.section__title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  letter-spacing: 1rpx;
  text-transform: uppercase;
}

.section__extra {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* ── Stats Grid ──────────────────────────────────────────── */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}


/* Skeleton */
.stats-skeleton {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.skeleton-card {
  height: 80rpx;
  background: linear-gradient(90deg, rgba(255,255,255,0.02) 25%, rgba(255,255,255,0.06) 50%, rgba(255,255,255,0.02) 75%);
  background-size: 200% 100%;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-border);
  animation: shimmer 1.4s infinite;
}

/* ── Current abnormal devices ─────────────────────────── */
.fault-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.fault-card {
  min-height: 150rpx;
  display: flex;
  align-items: stretch;
  overflow: hidden;
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  box-shadow: 0 4rpx 24rpx var(--color-shadow);
}

.fault-card:active {
  opacity: 0.78;
}

.fault-card__level {
  width: 8rpx;
  flex-shrink: 0;
}

.fault-card__body {
  min-width: 0;
  flex: 1;
  padding: 24rpx 20rpx 24rpx 24rpx;
}

.fault-card__header {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.fault-card__name {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fault-card__status {
  flex-shrink: 0;
  padding: 2rpx 12rpx;
  border: 1rpx solid;
  border-radius: var(--radius-pill);
  font-size: 21rpx;
}

.fault-card__code,
.fault-card__meta,
.fault-card__metrics {
  display: block;
  margin-top: 8rpx;
  overflow: hidden;
  color: var(--color-text-secondary);
  font-size: 23rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fault-card__meta {
  display: flex;
  gap: 8rpx;
}

.fault-card__metrics {
  color: var(--color-text-primary);
}

.fault-card__arrow {
  align-self: center;
  padding-right: 24rpx;
  color: var(--color-text-secondary);
  font-size: 48rpx;
  font-weight: 300;
}

@keyframes shimmer {
  0%   { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ── Entry List ──────────────────────────────────────────── */
.entry-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.entry-item {
  background: var(--color-bg-card);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 32rpx;
  display: flex;
  align-items: center;
  gap: 28rpx;
  box-shadow: 0 4rpx 24rpx var(--color-shadow);
  position: relative;
}

.entry-item--disabled {
  opacity: 0.7;
}

.entry-item__icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.entry-item__icon--blue  { background: rgba(0, 210, 255, 0.12); border: 1rpx solid rgba(0, 210, 255, 0.3); }
.entry-item__icon--red   { background: rgba(255, 51, 102, 0.12); border: 1rpx solid rgba(255, 51, 102, 0.3); }
.entry-item__icon--green { background: rgba(0, 255, 194, 0.12); border: 1rpx solid rgba(0, 255, 194, 0.3); }

.entry-item__icon-svg {
  width: 44rpx;
  height: 44rpx;
  mask-size: 100% 100%;
  -webkit-mask-size: 100% 100%;
  mask-repeat: no-repeat;
  -webkit-mask-repeat: no-repeat;
}

