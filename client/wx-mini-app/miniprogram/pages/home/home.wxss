.entry-item__icon--blue  .entry-item__icon-svg { background-color: #00D2FF; box-shadow: 0 0 12rpx rgba(0, 210, 255, 0.6); }
.entry-item__icon--red   .entry-item__icon-svg { background-color: #FF3366; box-shadow: 0 0 12rpx rgba(255, 51, 102, 0.6); }
.entry-item__icon--green .entry-item__icon-svg { background-color: #00FFC2; box-shadow: 0 0 12rpx rgba(0, 255, 194, 0.6); }

.entry-item__body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.entry-item__name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.entry-item__desc {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.entry-item__badge {
  font-size: 20rpx;
  color: var(--color-primary);
  background: var(--color-primary-dark);
  border-radius: var(--radius-pill);
  padding: 6rpx 16rpx;
  border: 1rpx solid var(--color-primary-light);
  flex-shrink: 0;
  box-shadow: 0 0 8rpx var(--color-primary-light);
}

/* ── Footer safe area ────────────────────────────────────── */
.footer-safe {
  height: 60rpx;
}
