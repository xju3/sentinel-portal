<!--pages/home/home.wxml-->
<scroll-view scroll-y class="page" enhanced show-scrollbar="{{false}}">

  <!-- Stats grid -->
  <view class="section">
    <view class="section__header">
      <view class="section__title-wrap">
        <view class="section__title-icon icon-overview" />
        <text class="section__title">设备概览</text>
      </view>
      <text class="section__extra">总计：{{total}} 台</text>
    </view>
    <view class="stats-grid" wx:if="{{!loading}}">
      <stat-card
        wx:for="{{stats}}"
        wx:key="label"
        item="{{item}}"
      />
    </view>
    <view class="stats-skeleton" wx:else>
      <view class="skeleton-card" wx:for="{{[1,2,3,4,5,6]}}" wx:key="*this" />
    </view>
  </view>

  <!-- Quick entry -->
  <view class="section">
    <view class="section__title-wrap" style="margin-bottom: 24rpx;">
      <view class="section__title-icon icon-bolt" />
      <text class="section__title">快速入口</text>
    </view>
    <view class="entry-list">
      <view class="entry-item" bindtap="navToCompare">
        <view class="entry-item__icon entry-item__icon--blue">
          <view class="entry-item__icon-svg icon-compare" />
        </view>
        <view class="entry-item__body">
          <text class="entry-item__name">分组对比</text>
          <text class="entry-item__desc">同规则, 同分组, 同工况设备之间比对</text>
        </view>
      </view>
      <view class="entry-item">
        <view class="entry-item__icon entry-item__icon--green">
          <view class="entry-item__icon-svg icon-profile" />
        </view>
        <view class="entry-item__body">
          <text class="entry-item__name">健康档案</text>
          <text class="entry-item__desc">设备诊断历史, 健康基线, FFT频谱查看</text>
        </view>
      </view>
    </view>
  </view>

  <view class="footer-safe" />
</scroll-view>
