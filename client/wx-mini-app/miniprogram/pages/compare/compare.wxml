<view class="container">
  <view class="spec-list">
    <spec-card 
      wx:for="{{specs}}" 
      wx:key="id" 
      item="{{item}}" 
      bind:click="navToDetail" 
      data-id="{{item.id}}" 
      data-name="{{item.name}}"
    />
    
    <empty-state wx:if="{{!loading && specs.length === 0}}" title="暂无可用对比规格" desc="未找到配置了测点分组的设备规格" />
  </view>
</view>
