<!--pages/register/register.wxml-->
<scroll-view scroll-y class="page" enhanced show-scrollbar="{{false}}">

  <!-- ── Success state ─────────────────────────────── -->
  <view class="success-wrap" wx:if="{{submitted}}">
    <view class="success-icon">
      <view class="checkmark" />
    </view>
    <text class="success-title">注册成功</text>
    <text class="success-body">我们已将密码设置链接发送至您的邮箱。\n请查收邮件并完成密码设置后，使用 Web 端登录系统。</text>
    <view class="tip-card">
      <text class="tip-card__text">💡 设置密码后，您可通过微信小程序直接访问工作台，无需再次注册。</text>
    </view>
  </view>

  <!-- ── Form state ─────────────────────────────────── -->
  <view class="form-wrap" wx:else>

    <!-- Hero -->
    <view class="hero">
      <view class="hero__dot-wrap">
        <view class="hero__dot" />
      </view>
      <text class="hero__title">企业注册</text>
      <text class="hero__subtitle">开启设备健康监测之旅</text>
    </view>

    <!-- Form card -->
    <view class="form-card card">

      <view class="field">
        <text class="field__label">公司名称<text class="field__required">*</text></text>
        <input
          class="field__input {{errors.company_name ? 'field__input--error' : ''}}"
          placeholder="请输入公司全称"
          placeholder-class="field__placeholder"
          data-field="company_name"
          value="{{form.company_name}}"
          bindinput="onInput"
          maxlength="80"
        />
        <text class="field__error" wx:if="{{errors.company_name}}">{{errors.company_name}}</text>
      </view>

      <view class="divider" />

      <view class="field">
        <text class="field__label">联系人姓名<text class="field__required">*</text></text>
        <input
          class="field__input {{errors.contact_name ? 'field__input--error' : ''}}"
          placeholder="请输入您的姓名"
          placeholder-class="field__placeholder"
          data-field="contact_name"
          value="{{form.contact_name}}"
          bindinput="onInput"
          maxlength="40"
        />
        <text class="field__error" wx:if="{{errors.contact_name}}">{{errors.contact_name}}</text>
      </view>

      <view class="divider" />

      <view class="field">
        <text class="field__label">手机号<text class="field__required">*</text></text>
        <input
          class="field__input {{errors.phone ? 'field__input--error' : ''}}"
          placeholder="请输入手机号"
          placeholder-class="field__placeholder"
          data-field="phone"
          value="{{form.phone}}"
          bindinput="onInput"
          type="number"
          maxlength="15"
        />
        <text class="field__error" wx:if="{{errors.phone}}">{{errors.phone}}</text>
      </view>

      <view class="divider" />

      <view class="field">
        <text class="field__label">邮箱地址<text class="field__required">*</text></text>
        <input
          class="field__input {{errors.email ? 'field__input--error' : ''}}"
          placeholder="用于接收密码设置邮件"
          placeholder-class="field__placeholder"
          data-field="email"
          value="{{form.email}}"
          bindinput="onInput"
          type="text"
          maxlength="120"
        />
        <text class="field__error" wx:if="{{errors.email}}">{{errors.email}}</text>
      </view>

    </view>

    <!-- Note -->
    <text class="form-note">注册后系统将向您的邮箱发送密码设置邮件，请确保邮箱地址准确。</text>

    <!-- Submit -->
    <button
      class="btn-submit {{submitting ? 'btn-submit--loading' : ''}}"
      bindtap="onSubmit"
      disabled="{{submitting}}"
    >
      <view class="btn-submit__spinner" wx:if="{{submitting}}" />
      <text>{{submitting ? '提交中...' : '立即注册'}}</text>
    </button>

  </view>

  <view class="footer-safe" />
</scroll-view>
