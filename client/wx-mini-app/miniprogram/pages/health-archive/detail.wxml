<scroll-view scroll-y class="page" enhanced show-scrollbar="{{false}}">
  <view class="device-header">
    <view>
      <text class="device-name">{{deviceName || '设备健康档案'}}</text>
      <text class="device-code" wx:if="{{archive && archive.device}}">设备编号：{{archive.device.code}}</text>
    </view>
    <view class="rpm-tag" wx:if="{{archive && archive.device && archive.device.rpm}}">{{archive.device.rpm}} RPM</view>
  </view>

  <view class="error-panel" wx:if="{{errorText && !archive}}">
    <text>{{errorText}}</text>
    <button class="retry-button" bindtap="retryArchive">重新加载</button>
  </view>

  <block wx:if="{{archive}}">
    <view class="section context-card">
      <view class="section-title">档案范围</view>
      <scroll-view scroll-x class="range-scroll" show-scrollbar="{{false}}">
        <view class="range-row">
          <view
            wx:for="{{rangeOptions}}"
            wx:key="value"
            class="filter-chip {{rangeIndex === index ? 'filter-chip--active' : ''}}"
            data-index="{{index}}"
            bindtap="changeArchiveRange"
          >{{item.label}}</view>
        </view>
      </scroll-view>

      <view class="context-row" wx:if="{{!calendarMode}}">
        <text class="context-label">时间粒度</text>
        <picker value="{{intervalIndex}}" range="{{intervalOptions}}" range-key="label" bindchange="changeInterval">
          <view class="picker-value">{{intervalOptions[intervalIndex].label}}⌄</view>
        </picker>
      </view>
      <view class="context-row" wx:if="{{points.length}}">
        <text class="context-label">监测点</text>
        <picker value="{{pointIndex}}" range="{{points}}" range-key="name" bindchange="changePoint">
          <view class="picker-value">{{points[pointIndex].name}}{{points[pointIndex].active ? '' : '（历史）'}}⌄</view>
        </picker>
      </view>
      <view class="context-row" wx:if="{{points.length}}">
        <text class="context-label">当前传感器</text>
        <text class="context-value {{selectedSensorText ? '' : 'context-value--muted'}}">{{selectedSensorText || '当前未绑定传感器'}}</text>
      </view>
      <view class="context-empty" wx:else>暂无监测点，以下展示设备级历史</view>
    </view>

    <view class="section">
      <view class="section-title">健康概览</view>
      <view class="summary-grid">
        <view class="summary-card">
          <text class="summary-label">完成诊断</text>
          <text class="summary-value">{{archive.summary.diagnosedCount}}</text>
        </view>
        <view class="summary-card summary-card--normal">
          <text class="summary-label">正常诊断</text>
          <text class="summary-value">{{archive.summary.normalCount}}</text>
        </view>
        <view class="summary-card summary-card--abnormal">
          <text class="summary-label">异常诊断</text>
          <text class="summary-value">{{archive.summary.abnormalCount}}</text>
        </view>
        <view class="summary-card summary-card--missed">
          <text class="summary-label">诊断缺口</text>
          <text class="summary-value">{{archive.summary.missedCount}}</text>
        </view>
      </view>
      <view class="processing-hint" wx:if="{{archive.summary.waitingCount || archive.summary.receivedCount}}">
        等待补传 {{archive.summary.waitingCount}} 条 · 正在处理 {{archive.summary.receivedCount}} 条
      </view>
    </view>

    <view class="section timeline-card">
      <view class="section-title">{{calendarMode ? '设备健康日历' : '健康时间轴'}}</view>
      <view class="section-subtitle">{{calendarMode ? '每格代表一个自然日，点击查看小时明细' : '每格代表一个时间段，点击查看诊断统计'}}</view>

      <block wx:if="{{buckets.length}}">
        <block wx:if="{{calendarMode}}">
          <view class="calendar-month" wx:for="{{calendarMonths}}" wx:key="key" wx:for-item="month">
            <text class="month-title">{{month.label}}</text>
            <view class="weekday-row">
              <text>日</text><text>一</text><text>二</text><text>三</text><text>四</text><text>五</text><text>六</text>
            </view>
            <view class="calendar-grid">
              <view class="day-cell day-cell--empty" wx:for="{{month.placeholders}}" wx:key="*this" />
              <view
                class="day-cell {{item.hasGap ? 'status-gap' : ''}}"
                wx:for="{{month.buckets}}"
                wx:key="startAt"
                style="background: {{item.color}};"
                data-start="{{item.startAt}}"
                bindtap="selectBucket"
              >{{item.dayLabel}}</view>
            </view>
          </view>
        </block>
        <scroll-view wx:else scroll-x class="timeline-scroll" show-scrollbar="{{false}}">
          <view class="timeline-row">
            <view
              class="timeline-item"
              wx:for="{{buckets}}"
              wx:key="startAt"
              data-start="{{item.startAt}}"
              bindtap="selectBucket"
            >
              <view class="timeline-block {{item.hasGap ? 'status-gap' : ''}}" style="background: {{item.color}};" />
              <text class="timeline-time">{{item.shortTime}}</text>
            </view>
          </view>
        </scroll-view>

        <view class="legend-row">
          <view class="legend-item" wx:for="{{legend}}" wx:key="key">
            <view class="legend-color" style="background: {{item.color}};" />
            <text>{{item.label}}</text>
          </view>
        </view>

        <view class="bucket-detail" wx:if="{{selectedBucket}}">
          <view class="bucket-detail__header">
            <text>{{selectedBucket.shortTime}} · {{selectedBucket.statusLabel}}</text>
            <view class="status-dot" style="background: {{selectedBucket.color}};" />
          </view>
          <view class="detail-metrics">
            <text>完成 {{selectedBucket.diagnosedCount}}</text>
            <text>异常 {{selectedBucket.abnormalCount}}</text>
            <text>缺口 {{selectedBucket.missedCount}}</text>
            <text>待补传 {{selectedBucket.waitingCount}}</text>
          </view>
          <view wx:if="{{calendarMode}}" class="day-detail">
            <text class="day-detail__title">24小时状态</text>
            <view class="day-loading" wx:if="{{dayDetailLoading}}">加载小时明细...</view>
            <view class="hour-grid" wx:elif="{{dayDetail}}">
              <view class="hour-item" wx:for="{{dayDetail.buckets}}" wx:key="startAt">
                <view class="hour-block {{item.hasGap ? 'status-gap' : ''}}" style="background: {{item.color}};">{{item.diagnosedCount || ''}}</view>
                <text>{{item.hourLabel}}</text>
              </view>
            </view>
          </view>
        </view>
      </block>
      <empty-state wx:else title="暂无健康记录" desc="该时间范围内没有诊断数据" />
    </view>

    <view class="section trend-card" wx:if="{{selectedLocationId}}">
      <view class="section-title">{{points[pointIndex].name}} · 历史趋势</view>
      <view class="tabs">
        <view class="tab {{trendTab === 'temperature' ? 'tab--active' : ''}}" data-tab="temperature" bindtap="switchTrendTab">温度</view>
        <view class="tab {{trendTab === 'vibration' ? 'tab--active' : ''}}" data-tab="vibration" bindtap="switchTrendTab">振动</view>
      </view>
      <view class="chart-filters">
        <picker value="{{trendRangeIndex}}" range="{{trendRangeOptions}}" range-key="label" bindchange="changeTrendRange">
          <view class="small-picker">范围：{{trendRangeOptions[trendRangeIndex].label}}⌄</view>
        </picker>
        <picker value="{{trendWindowIndex}}" range="{{trendWindowOptions}}" range-key="label" bindchange="changeTrendWindow">
          <view class="small-picker">窗口：{{trendWindowOptions[trendWindowIndex].label}}⌄</view>
        </picker>
      </view>
      <view class="chart-loading" wx:if="{{trendLoading}}">趋势加载中...</view>
      <view class="chart-error" wx:elif="{{trendError}}" bindtap="retryTrend">{{trendError}}，点击重试</view>
      <empty-state wx:elif="{{!trendData || !trendData.meta.pointCount}}" title="暂无趋势" desc="该测点在所选范围内没有数据" />
      <view wx:else class="chart-box">
        <ec-canvas id="health-trend-chart" canvas-id="health-trend-canvas" ec="{{trendEc}}" style="width:100%;height:100%;display:block;" />
      </view>
    </view>

    <view class="section fft-card">
      <view class="advanced-header" bindtap="toggleFft">
        <view>
          <text class="section-title">FFT 频谱分析</text>
          <text class="section-subtitle">设备级高级分析，不随监测点切换</text>
        </view>
        <text class="expand-icon">{{fftExpanded ? '收起' : '展开'}}</text>
      </view>
      <block wx:if="{{fftExpanded}}">
        <view class="chart-loading" wx:if="{{fftListLoading}}">FFT记录加载中...</view>
        <view class="chart-error" wx:elif="{{fftError}}" bindtap="retryFft">{{fftError}}，点击重试</view>
        <empty-state wx:elif="{{!fftRecords.length}}" title="暂无 FFT 记录" desc="该设备尚未上传频谱数据" />
        <block wx:else>
          <picker value="{{fftRecordIndex}}" range="{{fftRecords}}" range-key="label" bindchange="changeFftRecord">
            <view class="record-picker">记录：{{fftRecords[fftRecordIndex].label}}⌄</view>
          </picker>
          <view class="tabs tabs--compact">
            <view class="tab {{fftAxis === 'x' ? 'tab--active' : ''}}" data-axis="x" bindtap="switchFftAxis">X轴</view>
            <view class="tab {{fftAxis === 'y' ? 'tab--active' : ''}}" data-axis="y" bindtap="switchFftAxis">Y轴</view>
            <view class="tab {{fftAxis === 'z' ? 'tab--active' : ''}}" data-axis="z" bindtap="switchFftAxis">Z轴</view>
          </view>
          <view class="mode-row">
            <view class="mode-chip {{fftMode === 'low' ? 'mode-chip--active' : ''}}" data-mode="low" bindtap="switchFftMode">0-1000Hz</view>
            <view class="mode-chip {{fftMode === 'full' ? 'mode-chip--active' : ''}}" data-mode="full" bindtap="switchFftMode">全频带</view>
          </view>
          <view class="fft-meta">
            采样 {{fftRecords[fftRecordIndex].fs_hz}}Hz · {{fftRecords[fftRecordIndex].points}}点 · {{fftRecords[fftRecordIndex].range_g}}g
          </view>
          <view class="chart-loading" wx:if="{{fftDataLoading}}">频谱加载中...</view>
          <view wx:else class="chart-box">
            <ec-canvas id="health-fft-chart" canvas-id="health-fft-canvas" ec="{{fftEc}}" style="width:100%;height:100%;display:block;" />
          </view>
        </block>
      </block>
    </view>
  </block>

  <view class="initial-loading" wx:if="{{loading && !archive}}">健康档案加载中...</view>
  <view class="safe-bottom" />
</scroll-view>
