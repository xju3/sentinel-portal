<view class="page">
  <view class="device-header">
    <view>
      <text class="device-name">{{deviceName || '设备健康档案'}}</text>
      <text class="device-code" wx:if="{{archive && archive.device}}">设备编号：{{archive.device.code}}</text>
    </view>
    <view class="rpm-tag" wx:if="{{archive && archive.device && archive.device.rpm}}">{{archive.device.rpm}} RPM</view>
  </view>

  <view class="error-panel" wx:if="{{errorText && !archive}}">
    <text>{{errorText}}</text>
    <button class="retry-button" bindtap="retryArchive">重新加载</button>
  </view>

  <block wx:if="{{archive}}">
    <view class="section context-card">
      <view class="range-head">
        <view class="section-title">档案范围</view>
        <view class="range-row">
          <view
            wx:for="{{rangeOptions}}"
            wx:key="value"
            class="filter-chip {{rangeIndex === index ? 'filter-chip--active' : ''}}"
            data-index="{{index}}"
            bindtap="changeArchiveRange"
          >{{item.label}}</view>
        </view>
      </view>

      <view class="context-meta" wx:if="{{points.length}}">
        <picker class="context-meta__point" value="{{pointIndex}}" range="{{points}}" range-key="name" bindchange="changePoint">
          <view class="context-meta__item">
            <text class="context-label">监测点</text>
            <text class="picker-value">{{points[pointIndex].name}}{{points[pointIndex].active ? '' : '（历史）'}}⌄</text>
          </view>
        </picker>
        <view class="context-meta__divider"></view>
        <view class="context-meta__item context-meta__sensor">
          <text class="context-label">传感器</text>
          <text class="context-value {{selectedSensorText ? '' : 'context-value--muted'}}">{{selectedSensorText || '当前未绑定'}}</text>
        </view>
      </view>
      <view class="context-empty" wx:else>暂无监测点，以下展示设备级历史</view>
    </view>

    <view class="section overview-card">
      <view class="section-title">健康概览</view>
      <view class="summary-grid">
        <view class="summary-card">
          <text class="summary-label">完成诊断</text>
          <text class="summary-value">{{archive.summary.diagnosedCount}}</text>
        </view>
        <view class="summary-card summary-card--normal">
          <text class="summary-label">正常诊断</text>
          <text class="summary-value">{{archive.summary.normalCount}}</text>
        </view>
        <view class="summary-card summary-card--abnormal">
          <text class="summary-label">异常诊断</text>
          <text class="summary-value">{{archive.summary.abnormalCount}}</text>
        </view>
        <view class="summary-card summary-card--missed">
          <text class="summary-label">诊断缺口</text>
          <text class="summary-value">{{archive.summary.missedCount}}</text>
        </view>
      </view>
      <view class="processing-hint" wx:if="{{archive.summary.waitingCount || archive.summary.receivedCount}}">
        等待补传 {{archive.summary.waitingCount}} 条 · 正在处理 {{archive.summary.receivedCount}} 条
      </view>
    </view>

    <view class="section timeline-card">
      <view class="section-title">健康时间轴</view>
      <view class="section-subtitle">每24小时一行、每小时一格；最后一格结束于当前时间</view>

      <block wx:if="{{buckets.length}}">
        <scroll-view scroll-x class="timeline-scroll" show-scrollbar="{{false}}" enhanced>
          <view class="timeline-table">
            <view class="day-row" wx:for="{{timelineDays}}" wx:key="key" wx:for-item="day">
              <text class="day-row-label">{{day.label}}</text>
              <view
                class="hour-status {{item.hasGap ? 'status-gap' : ''}}"
                wx:for="{{day.buckets}}"
                wx:key="startAt"
                style="background: {{item.color}};"
                data-start="{{item.startAt}}"
                bindtap="selectBucket"
              >{{item.diagnosedCount || ''}}</view>
            </view>
          </view>
        </scroll-view>

        <view class="legend-row">
          <view class="legend-item" wx:for="{{legend}}" wx:key="key">
            <view class="legend-color" style="background: {{item.color}};" />
            <text>{{item.label}}</text>
          </view>
        </view>

        <view class="bucket-detail" wx:if="{{selectedBucket}}">
          <view class="bucket-detail__header">
            <text>{{selectedBucket.rangeLabel}} · {{selectedBucket.statusLabel}}</text>
            <view class="status-dot" style="background: {{selectedBucket.color}};" />
          </view>
          <view class="detail-metrics">
            <text>完成 {{selectedBucket.diagnosedCount}}</text>
            <text>异常 {{selectedBucket.abnormalCount}}</text>
            <text>缺口 {{selectedBucket.missedCount}}</text>
            <text>待补传 {{selectedBucket.waitingCount}}</text>
          </view>
        </view>
      </block>
      <empty-state wx:else title="暂无健康记录" desc="该时间范围内没有诊断数据" />
    </view>

    <view class="section trend-card" wx:if="{{selectedLocationId}}">
      <view class="section-title">{{points[pointIndex].name}} · 历史趋势</view>
      <view class="tabs">
        <view class="tab {{trendTab === 'temperature' ? 'tab--active' : ''}}" data-tab="temperature" bindtap="switchTrendTab">温度</view>
        <view class="tab {{trendTab === 'vibration' ? 'tab--active' : ''}}" data-tab="vibration" bindtap="switchTrendTab">振动</view>
      </view>
      <view class="chart-filters">
        <picker value="{{trendRangeIndex}}" range="{{trendRangeOptions}}" range-key="label" bindchange="changeTrendRange">
          <view class="small-picker">范围：{{trendRangeOptions[trendRangeIndex].label}}⌄</view>
        </picker>
        <picker value="{{trendWindowIndex}}" range="{{trendWindowOptions}}" range-key="label" bindchange="changeTrendWindow">
          <view class="small-picker">窗口：{{trendWindowOptions[trendWindowIndex].label}}⌄</view>
        </picker>
      </view>
      <view class="chart-loading" wx:if="{{trendLoading}}">趋势加载中...</view>
      <view class="chart-error" wx:elif="{{trendError}}" bindtap="retryTrend">{{trendError}}，点击重试</view>
      <empty-state wx:elif="{{!trendData || !trendData.meta.pointCount}}" title="暂无趋势" desc="该测点在所选范围内没有数据" />
      <view wx:else class="chart-stage {{fullscreenChart === 'trend' ? 'chart-stage--fullscreen' : ''}}">
        <view class="chart-fullscreen-header">
          <text wx:if="{{fullscreenChart === 'trend'}}">{{trendTab === 'temperature' ? '温度趋势' : '振动趋势'}}</text>
          <view class="chart-fullscreen-button" data-chart="trend" bindtap="toggleChartFullscreen">
            {{fullscreenChart === 'trend' ? '退出全屏' : '全屏'}}
          </view>
        </view>
        <view id="trend-chart-box" class="chart-box">
          <ec-canvas id="health-trend-chart" canvas-id="health-trend-canvas" force-use-old-canvas="false" ec="{{trendEc}}" style="width:100%;height:100%;display:block;" />
        </view>
      </view>
    </view>
  </block>

  <view class="initial-loading" wx:if="{{loading && !archive}}">健康档案加载中...</view>
  <view class="safe-bottom" />
</view>
