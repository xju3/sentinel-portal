.page {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
}

.page__hero {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 24rpx;
  padding: 28rpx;
}

.page__hero-head { display:flex; align-items:center; justify-content:space-between; gap:20rpx; }
.page__hero-actions { display:flex; align-items:center; gap:12rpx; flex-shrink:0; }
.page__favorite-count { padding:7rpx 12rpx; border-radius:999rpx; background:rgba(255,196,64,.1); color:#ffc440; font-size:19rpx; }
.filter-trigger { display:flex; align-items:center; gap:8rpx; padding:10rpx 18rpx; border:1rpx solid rgba(0,210,255,.22); border-radius:999rpx; color:var(--color-primary); font-size:22rpx; }
.filter-trigger--active { background:rgba(0,210,255,.1); border-color:rgba(0,210,255,.42); }
.filter-trigger__chevron { font-size:22rpx; transition:transform .2s ease; }

.page__hero-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.page__hero-desc {
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--color-text-secondary);
}

.page__filter-summary { overflow:hidden; color:var(--color-primary); font-size:21rpx; text-overflow:ellipsis; white-space:nowrap; }
.filter-reset { color:var(--color-primary); font-size:22rpx; text-align:right; }
.filter-error { display:flex; align-items:center; justify-content:space-between; gap:20rpx; color:#ffb86b; font-size:21rpx; }
.filter-error__retry { flex-shrink:0; padding:10rpx 18rpx; border:1rpx solid rgba(0,210,255,.3); border-radius:999rpx; color:var(--color-primary); }
.filter-overlay { position:fixed; z-index:1000; top:0; left:0; width:100vw; height:100vh; box-sizing:border-box; background:rgba(0,0,0,.58); }
.filter-sheet { display:flex; flex-direction:column; max-height:72vh; padding:28rpx 32rpx 34rpx; box-sizing:border-box; border-radius:0 0 32rpx 32rpx; background:#121a2a; box-shadow:0 18rpx 48rpx rgba(0,0,0,.4); }
.filter-sheet__header { display:flex; align-items:center; justify-content:space-between; gap:24rpx; }
.filter-sheet__title { display:block; color:var(--color-text-primary); font-size:32rpx; font-weight:600; }
.filter-sheet__hint { display:block; margin-top:6rpx; color:var(--color-text-secondary); font-size:20rpx; }
.filter-sheet__done { padding:12rpx 24rpx; border-radius:999rpx; background:var(--color-primary); color:#07101c; font-size:23rpx; font-weight:600; }
.filter-tabs { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:14rpx; margin:26rpx 0 18rpx; }
.filter-tab { padding:16rpx 12rpx; border:1rpx solid rgba(255,255,255,.08); border-radius:16rpx; background:rgba(255,255,255,.04); color:var(--color-text-secondary); font-size:23rpx; text-align:center; }
.filter-tab--active { border-color:rgba(0,210,255,.55); background:rgba(0,210,255,.1); color:var(--color-primary); }
.filter-options { max-height:48vh; }
.filter-options__label { padding:12rpx 4rpx; color:var(--color-text-secondary); font-size:20rpx; }
.filter-option { display:flex; align-items:center; justify-content:space-between; min-height:84rpx; padding:0 6rpx; border-bottom:1rpx solid rgba(255,255,255,.07); color:var(--color-text-primary); font-size:27rpx; }
.filter-option--selected { color:var(--color-primary); font-weight:600; }
.filter-option__check { color:var(--color-primary); font-size:25rpx; }
.filter-sheet__footer { display:flex; align-items:center; justify-content:space-between; gap:20rpx; padding-top:22rpx; }
.filter-sheet__summary { overflow:hidden; color:var(--color-text-secondary); font-size:20rpx; text-overflow:ellipsis; white-space:nowrap; }
.filter-empty { padding-top:40rpx; text-align:center; }
.filter-empty__reset { display:inline-flex; margin-top:12rpx; padding:14rpx 28rpx; border:1rpx solid rgba(0,210,255,.28); border-radius:999rpx; color:var(--color-primary); font-size:24rpx; }

.device-list,
.skeleton-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.page-status {
  padding: 20rpx 0 28rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.skeleton-card {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  background: linear-gradient(90deg, rgba(255, 255, 255, 0.02) 25%, rgba(255, 255, 255, 0.06) 50%, rgba(255, 255, 255, 0.02) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.4s infinite;
}

.skeleton-card__line {
  border-radius: 9999rpx;
  background: rgba(255, 255, 255, 0.12);
}

.skeleton-card__line--lg {
  width: 48%;
  height: 28rpx;
}

.skeleton-card__line--md {
  width: 34%;
  height: 20rpx;
}

.skeleton-card__line--sm {
  width: 82%;
  height: 20rpx;
}

.skeleton-card__metrics {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.skeleton-card__metric {
  height: 96rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.08);
}

@keyframes shimmer {
  0% {
    background-position: 200% 0;
  }
  100% {
    background-position: -200% 0;
  }
}
