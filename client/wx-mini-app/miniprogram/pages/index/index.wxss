/**pages/index/index.wxss — Splash screen styles**/
page {
  height: 100vh;
}

.splash {
  height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 180rpx 60rpx 120rpx;
  background: linear-gradient(160deg, #040B16 0%, #08162A 45%, #0B1D38 100%);
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}

/* Optional subtle background grid/glow effects could be added here */
.splash::before {
  content: '';
  position: absolute;
  top: -20%; left: -20%;
  width: 140%; height: 140%;
  background: radial-gradient(circle at 50% 30%, rgba(26, 110, 245, 0.08) 0%, transparent 60%);
  pointer-events: none;
}

/* ── Brand ──────────────────────────────────────────── */
.splash__brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
  margin-top: 60rpx;
  z-index: 1;
}

.splash__logo {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.splash__logo-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  animation: float 4s ease-in-out infinite;
  filter: drop-shadow(0 8rpx 24rpx rgba(0, 200, 151, 0.2));
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12rpx); }
}

.splash__name {
  font-size: 60rpx;
  font-weight: 800;
  color: #FFFFFF;
  letter-spacing: 6rpx;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.5);
  background: linear-gradient(180deg, #FFFFFF 0%, #E0E7FF 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.splash__tagline {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
  letter-spacing: 4rpx;
  text-transform: uppercase;
}

/* ── Footer ─────────────────────────────────────────── */
.splash__footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 28rpx;
  width: 100%;
}

/* Spinner */
.spinner {
  width: 64rpx;
  height: 64rpx;
  position: relative;
}

.spinner__arc {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 5rpx solid rgba(255, 255, 255, 0.1);
  border-top-color: #00D2FF;
  box-shadow: 0 0 16rpx rgba(0, 210, 255, 0.4);
  animation: spin 1s cubic-bezier(0.68, -0.55, 0.265, 1.55) infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.splash__hint {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  letter-spacing: 2rpx;
}

.splash__error {
  font-size: 26rpx;
  color: rgba(242, 92, 84, 0.9);
  text-align: center;
  line-height: 1.6;
}

/* Retry button */
.btn--primary {
  background: #1A6EF5;
  color: #FFFFFF;
  border-radius: var(--radius-pill);
  font-size: var(--font-base);
  font-weight: 600;
  padding: 0 60rpx;
  height: 88rpx;
  line-height: 88rpx;
  border: none;
  min-width: 280rpx;
  box-shadow: 0 8rpx 24rpx rgba(26, 110, 245, 0.4);
}
