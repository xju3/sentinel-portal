/**app.wxss — Global design tokens & base styles **/

/* ── Color Tokens ─────────────────────────────────────────── */
page {
  --color-bg: #0A0F1C;
  --color-bg-card: rgba(20, 30, 48, 0.6);
  --color-primary: #00D2FF;
  --color-primary-dark: #07192C;
  --color-primary-light: rgba(0, 210, 255, 0.15);
  --color-accent: #00FFC2;
  --color-danger: #FF3366;
  --color-warning: #FFB020;
  --color-text-primary: #FFFFFF;
  --color-text-secondary: #8A9BB3;
  --color-text-placeholder: #4B5A73;
  --color-border: rgba(0, 210, 255, 0.15);
  --color-shadow: rgba(0, 210, 255, 0.08);

  /* ── Spacing Tokens ───────────────────────────────────────── */
  --space-xs: 8rpx;
  --space-sm: 16rpx;
  --space-md: 24rpx;
  --space-lg: 40rpx;
  --space-xl: 64rpx;

  /* ── Radius Tokens ────────────────────────────────────────── */
  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 32rpx;
  --radius-pill: 9999rpx;

  /* ── Font Tokens ──────────────────────────────────────────── */
  --font-xs: 22rpx;
  --font-sm: 26rpx;
  --font-base: 30rpx;
  --font-md: 34rpx;
  --font-lg: 40rpx;
  --font-xl: 52rpx;
  --font-2xl: 68rpx;

  /* ── Base ─────────────────────────────────────────────────── */
  background-color: var(--color-bg);
  background-image: 
    linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
  background-size: 40rpx 40rpx;
  background-position: center top;
  color: var(--color-text-primary);
  font-family: "DIN Alternate", -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: var(--font-base);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

/* ── Utility ──────────────────────────────────────────────── */
.text-secondary { color: var(--color-text-secondary); }
.text-primary   { color: var(--color-primary); }
.text-danger    { color: var(--color-danger); }

.card {
  background: var(--color-bg-card);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  box-shadow: 0 4rpx 24rpx var(--color-shadow);
  overflow: hidden;
}
